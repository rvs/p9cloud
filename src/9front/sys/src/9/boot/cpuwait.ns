# name space of rcpu clients of a cpuwait server, before
# the client supplies the root (see /rc/bin/cpuwait.service).

# kernel devices
bind #c /dev
bind #d /fd
bind -c #e /env
bind #p /proc
bind -c #s /srv
bind -q #σ /shr
bind -a #¤ /dev
bind -qa #¶ /dev

# the boot file system stands in for the root
mount /srv/bootfs /root
bind -a /root /

# mount points
mount -a /srv/slashn /n
mount -a /srv/slashmnt /mnt
mount -a /srv/mntexport /mnt/exportfs

# authentication
mount /srv/factotum /mnt/factotum factotum
bind -q /mnt/factotum/factotum /mnt/factotum

# standard bin, from the boot file system
bind /root/$cputype/bin /bin
bind /root/rc /rc
bind -a /rc/bin /bin

# internal networks
bind -a #l /net
bind -a #I /net
bind -a #a /net
