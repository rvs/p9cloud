#!/bin/rc
# kernel.rc: make the cpuwait kernel from /sys/src/9 and install it
# as /amd64/9pc64cpuwait.  Its configuration is the stock pc64; the
# name alone makes mk use pc64cpuwait.bootfs.proto for its boot
# file system (see ../boot/bootmkfile).
rfork e
objtype=amd64
cd /sys/src/9/pc64 &&
cp pc64 pc64cpuwait &&
mk 'CONF=pc64cpuwait' install
