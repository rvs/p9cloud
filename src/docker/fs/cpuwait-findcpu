#!/usr/bin/env python3
# cpuwait-findcpu cpu port wait: print the first host answering on port
import socket, struct, sys, time
cpu, port, wait = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
def gateway():
    try:
        for line in open("/proc/net/route").readlines()[1:]:
            f = line.split()
            if f[1] == "00000000":
                return socket.inet_ntoa(struct.pack("<L", int(f[2], 16)))
    except OSError:
        pass
hosts = [cpu] if cpu else [h for h in ("host.docker.internal", gateway()) if h]
if wait <= 0:
    print(hosts[0]); sys.exit(0)
end = time.monotonic() + wait
while True:
    for h in hosts:
        # qemu's hostfwd accepts before the guest listens, so wait for
        # the server's first bytes (its p9any offer), not just a connect
        try:
            with socket.create_connection((h, port), 1) as s:
                s.settimeout(2)
                if s.recv(1):
                    print(h); sys.exit(0)
        except OSError:
            pass
    if time.monotonic() >= end:
        sys.exit(1)
    time.sleep(0.2)
