	qemu-system-x86_64 -enable-kvm -cpu host -m 1536 -smp 2 -kernel $LAB/images/9pc64 -append 'console=0 sysname=fs auth=10.99.0.10 fs=10.99.0.10 service=cpu nobootprompt=local!/dev/sdF0/fs nvram=/dev/sdF0/nvram' -drive file=$LAB/images/fs-os.qcow2,if=virtio,format=qcow2 -drive file=$LAB/images/shared.qcow2,if=virtio,format=qcow2 -netdev tap,id=lab,ifname=p9fs,script=no,downscript=no -device virtio-net-pci,netdev=lab,mac=52:54:00:99:00:10 -display none -monitor unix:$LAB/state/fs/monitor.sock,server=on,wait=off -chardev socket,id=s,path=$LAB/state/fs/serial.sock,server=on,wait=off,logfile=$LAB/state/fs/console.log -serial chardev:s
