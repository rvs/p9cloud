sys=amd: p9.lab:27, qemu
	sys=amd
	ip=10.99.0.11
	ether=525400990011
	dom=amd.p9lab
	qemu=qemu-system-x86_64
	accel=kvm
	cpumodel=host
	mem=2G
	smp=2
	bootf=images/9pc64
	disk=secrets/amd.nvram
	virtio=modern
	ini.nvram=/dev/sdF0/data
	ini.nobootprompt="tcp ether /net/ether0 $ip $ipmask"
	ready=rcpu
	ipnet=p9lab                                           from ipnet=p9lab
	ipmask=255.255.255.0                                  from ipnet=p9lab
	fs=10.99.0.10                                         from ipnet=p9lab
	auth=10.99.0.10                                       from ipnet=p9lab
	ntp=10.99.0.10                                        from ipnet=p9lab
	ini.console=0                                         from ipnet=p9lab
	ini.sysname=$sys                                      from ipnet=p9lab
	ini.auth=$auth                                        from ipnet=p9lab
	ini.fs=$fs                                            from ipnet=p9lab
	ini.service=cpu                                       from ipnet=p9lab
kernel:
	console=0             ipnet=p9lab
	sysname=amd           ipnet=p9lab
	auth=10.99.0.1        -k
	fs=10.99.0.10         ipnet=p9lab
	service=cpu           ipnet=p9lab
	nvram=/dev/sdF0/data  sys=amd
	foo='a b'             -k
	x='it''s'             -k
command:
	docker run --rm --name p9lab-amd --network p9br --ip 10.99.0.11 --cap-add NET_ADMIN --device /dev/net/tun --device /dev/kvm -e QEMU_USER=$QEMU_USER --mount type=bind,src=$LAB/images/9pc64,dst=$LAB/images/9pc64,ro --mount type=bind,src=$LAB/secrets/amd.nvram,dst=$LAB/secrets/amd.nvram --mount type=bind,src=$LAB/state/amd,dst=$LAB/state/amd 9front-qemu qemu-system-x86_64 -enable-kvm -cpu host -m 2G -smp 2 -kernel $LAB/images/9pc64 -append 'console=0 sysname=amd auth=10.99.0.1 fs=10.99.0.10 service=cpu nvram=/dev/sdF0/data foo='"'"'a b'"'"' x='"'"'it'"'"''"'"'s'"'"'' -drive file=$LAB/secrets/amd.nvram,if=none,id=sdF0,format=raw -device virtio-blk-pci,drive=sdF0,disable-legacy=on -netdev tap,id=lab,ifname=tap0,script=no,downscript=no -device virtio-net-pci,netdev=lab,mac=52:54:00:99:00:11,disable-legacy=on -display none -monitor unix:$LAB/state/amd/monitor.sock,server=on,wait=off -chardev socket,id=s,path=$LAB/state/amd/serial.sock,server=on,wait=off,logfile=$LAB/state/amd/console.log -serial chardev:s -s -d int
needs: fs
